# Whisky Project — environment configuration
# Copy this file to .env and adjust values for your deployment.

# Prefix for task folder names on Google Drive (must match what your agent writes)
WHISKY_PREFIX=WSC_1_7_

# Absolute path to the rclone-mounted Google Drive directory
WHISKY_IO_DIR=/home/whisky/whisky_drive

# Timeout in seconds for each task command
WHISKY_CMD_TIMEOUT=600
