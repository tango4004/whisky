# Whisky Project v1.8 — environment configuration
# Copy this file to .env and fill in your values.

# Prefix this instance watches on Google Drive (must be unique per server)
WHISKY_PREFIX=WS8_

# Absolute path to the rclone-mounted Google Drive directory
WHISKY_IO_DIR=/home/whisky/whisky_drive

# Timeout in seconds for each shell command (default: 600)
WHISKY_CMD_TIMEOUT=600

# Anthropic API key (required — used by claude_parser.py)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude model for command extraction (default: claude-haiku-4-5-20251001)
CLAUDE_PARSER_MODEL=claude-haiku-4-5-20251001

# Paths to parser scripts (defaults are relative to this directory)
WHISKY_CLAUDE_PARSER=/home/whisky/whisky-project/whisky_1_8/claude_parser.py
WHISKY_EXTRACT_SCRIPT=/home/whisky/whisky-project/whisky_1_8/extract_text.py
